# ============================================================
# BETGO - Variables de Entorno
# ============================================================

# Entorno
NODE_ENV=development
PORT=3000

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=betgo
DB_PASSWORD=
DB_DATABASE=betgo_db
DB_DIALECT=postgres

# Conexión completa (alternativa)
DATABASE_URL=postgresql://betgo:betgo_secret_2026@localhost:5432/betgo_db

# JWT para autenticación
JWT_SECRET=secreto_jwt
JWT_EXPIRES_IN=7d

# Configuración de códigos QR
QR_CODE_EXPIRATION_MINUTES=5
PRIZE_CLAIM_EXPIRATION_DAYS=7

# Logging
LOG_LEVEL=debug
