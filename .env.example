# ============================================================
# BETGO - Variables de Entorno
# ============================================================

# Entorno
NODE_ENV=development
PORT=3000

# Orígenes permitidos para llamar a la API desde el navegador (separados por
# coma). localhost:4200 y 127.0.0.1:4200 ya están habilitados siempre.
CORS_ORIGINS=

# Base de Datos PostgreSQL
# DB_HOST: usar "betgo_postgres" si corrés el backend en Docker.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=betgo
DB_PASSWORD=betgo_secret_2026
DB_DATABASE=betgo_db
DB_DATABASE_TEST=betgo_db_test
DB_DIALECT=postgres

# Conexión completa (alternativa)
DATABASE_URL=postgresql://betgo:betgo_secret_2026@localhost:5432/betgo_db

# JWT para autenticación
JWT_SECRET=tu_secreto_super_seguro_minimo_32_caracteres_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# URL base del front (se usa para armar las URLs de los QR)
APP_URL=http://localhost:4200

# Configuración de códigos QR
QR_CODE_EXPIRATION_MINUTES=5
PRIZE_CLAIM_EXPIRATION_DAYS=7

# Logging
LOG_LEVEL=debug

#Testeo de componentes
FORCE_WIN=false

# Cloudinary (para subir imágenes y banners)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BANNERS_FOLDER=betgo/banners
CLOUDINARY_PRIZES_FOLDER=betgo/prizes
CLOUDINARY_BARS_FOLDER=betgo/bars
CLOUDINARY_SYMBOLS_FOLDER=betgo/symbols
