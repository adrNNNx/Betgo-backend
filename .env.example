# ============================================================
# BETGO - Variables de Entorno
# ============================================================

# Entorno
NODE_ENV=development
PORT=3000

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=betgo
DB_PASSWORD=
DB_DATABASE=betgo_db
DB_DIALECT=postgres

# Conexión completa (alternativa)
DATABASE_URL=postgresql://betgo:betgo_secret_2026@localhost:5432/betgo_db

# JWT para autenticación
JWT_SECRET=tu_secreto_super_seguro_minimo_32_caracteres_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Configuración de códigos QR
QR_CODE_EXPIRATION_MINUTES=5
PRIZE_CLAIM_EXPIRATION_DAYS=7

# Logging
LOG_LEVEL=debug

#Testeo de componentes
FORCE_WIN=false

# Cloudinary (para subir imágenes y banners)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BANNERS_FOLDER=betgo/banners
CLOUDINARY_PRIZES_FOLDER=betgo/prizes
